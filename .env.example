# Copy to .env.local and set the Laravel API address reachable by your phone.
VITE_API_BASE_URL=https://achilleswearyourweakness.shop/api
# Enable only after adding android/app/google-services.json and configuring the server.
VITE_PUSH_ENABLED=false

# Normal GETs make at most two bounded attempts (8s + short backoff + 8s).
# Mutations are never automatically retried. The bulk approval operation has
# the separate bounded long timeout below.
VITE_API_TIMEOUT_MS=8000
VITE_API_LONG_TIMEOUT_MS=20000
VITE_API_GET_RETRIES=1
VITE_API_RETRY_BASE_MS=350
VITE_API_MAX_RETRY_AFTER_MS=5000
